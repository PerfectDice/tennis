<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 1. 카메라 라이브 프리뷰 -->
    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 2. 정밀 분석용 비디오 뷰 -->
    <VideoView
        android:id="@+id/videoView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- 3. 화면 터치 감지 오버레이 -->
    <View
        android:id="@+id/touchOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 4. 상단 상태 및 안내 가이드 -->
    <TextView
        android:id="@+id/tvGuide"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="1단계: 내 쪽 베이스라인 [좌측 코너]를 터치하세요"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:background="#CC000000"
        android:padding="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/layoutScoreboard" />

    <!-- 5. 대형 전광판 (속도 및 상세 수치) -->
    <LinearLayout
        android:id="@+id/layoutScoreboard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#E6111111"
        android:padding="16dp"
        android:gravity="end"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvSpeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--- KM/H"
            android:textColor="#00FF66"
            android:textSize="56sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSubStats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="거리: -- m | 시간: -- s"
            android:textColor="#CCCCCC"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- 6. 하단 컨트롤 패널 -->
    <LinearLayout
        android:id="@+id/layoutControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#CC000000"
        android:padding="10dp"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/btnResetCalib"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="코트 재설정"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnModeLive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="실시간 모드"
            android:backgroundTint="#2196F3"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnLoadVideo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="영상 불러오기"
            android:backgroundTint="#FF9800"
            android:layout_marginEnd="16dp" />

        <!-- 영상 분석 모드 전용 버튼들 -->
        <Button
            android:id="@+id/btnPrevFrame"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="◀ 1F"
            android:visibility="gone"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnNextFrame"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1F ▶"
            android:visibility="gone"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnSetImpact"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="임팩트 지정"
            android:visibility="gone"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnSetBounce"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="바운드 지정"
            android:visibility="gone"
            android:backgroundTint="#F44336" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
