<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <VideoView
        android:id="@+id/videoView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- 터치 좌표 및 캘리브레이션 시각화 오버레이 -->
    <View
        android:id="@+id/touchOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 상단 상태 안내바 -->
    <TextView
        android:id="@+id/tvGuide"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="1단계: 내 쪽 베이스라인 [좌측 코너]를 터치하세요"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:background="#CC000000"
        android:padding="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/layoutScoreboard" />

    <!-- 대형 전광판 HUD (초속 + 평균속도 + 실측거리) -->
    <LinearLayout
        android:id="@+id/layoutScoreboard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#DD111111"
        android:padding="16dp"
        android:gravity="end"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvInitSpeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--- KM/H"
            android:textColor="#00FF66"
            android:textSize="56sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSubStats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="평균: -- km/h | 거리: -- m | 시간: -- s"
            android:textColor="#CCCCCC"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- 하단 컨트롤 바 -->
    <LinearLayout
        android:id="@+id/layoutControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#CC000000"
        android:padding="8dp"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/btnResetCalib"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="코트 재설정"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnLoadVideo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="영상 불러오기"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnPrevFrame"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="◀ 1F"
            android:visibility="gone"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnNextFrame"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1F ▶"
            android:visibility="gone"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnSetImpact"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="임팩트(I)"
            android:visibility="gone"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnSetBounce"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="바운드(B)"
            android:visibility="gone"
            android:backgroundTint="#FF4444" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
